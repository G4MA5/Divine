# Copier ce fichier en .env.local (jamais committé) et renseigner les valeurs.

# Supabase : Project Settings > API. Seule la clé « anon » (publique) est utilisée par le site.
# Sans ces deux variables, le site affiche le contenu du dossier /content.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Secret qui autorise l'application de commande à rafraîchir le site tout de suite (POST /api/revalidate).
# Choisir une longue chaîne aléatoire, la mettre aussi dans l'application.
REVALIDATE_SECRET=

# Adresse publique du site (pour le plan du site et les aperçus de partage).
NEXT_PUBLIC_SITE_URL=https://mon-portfolio.vercel.app

# Facultatif : service externe de formulaire, utilisé seulement si Supabase n'est pas configuré.
NEXT_PUBLIC_FORM_ENDPOINT=
